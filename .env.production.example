# ═══════════════════════════════════════════════════════════════════════════
# PHISHGUARD PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════

# ── Django Core Settings ───────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_SECRET_KEY_IN_PRODUCTION
ALLOWED_HOSTS=api.phishguard.io,phishguard.io,127.0.0.1,localhost

# ── Database (MySQL / MariaDB) ──────────────────────────────────────────────
DB_ENGINE=django.db.backends.mysql
DB_NAME=phishguard_prod_db
DB_USER=phishguard_db_user
DB_PASSWORD=SET_VERY_STRONG_DB_PASSWORD_HERE
DB_HOST=db
DB_PORT=3306
DB_CONNECT_TIMEOUT=5

# ── Redis Cache & Broker ───────────────────────────────────────────────────
USE_REDIS_CACHE=True
REDIS_PASSWORD=SET_STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:SET_STRONG_REDIS_PASSWORD_HERE@redis:6379/0

# ── CORS & Security Headers ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://phishguard.io,https://app.phishguard.io
CSRF_TRUSTED_ORIGINS=https://phishguard.io,https://app.phishguard.io
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── Throttling & Rate Limiting ─────────────────────────────────────────────
DRF_THROTTLE_ANON=20/hour
DRF_THROTTLE_USER=100/hour
DRF_THROTTLE_LOGIN=10/hour
DRF_THROTTLE_REGISTER=5/hour

# ── Threat Intelligence API Keys (Optional — Fallback to Heuristics if unset) ──
VIRUSTOTAL_API_KEY=your_virustotal_api_key_v3_here
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_v4_here

# ── Error Tracking (Sentry) ────────────────────────────────────────────────
SENTRY_DSN=https://YOUR_SENTRY_DSN_KEY@o0.ingest.sentry.io/0000000

# ── Gunicorn Tuning ────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
